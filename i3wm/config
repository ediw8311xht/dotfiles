
# vi:ft=i3:syntax=i3:
#---------------------------------------------------------------------|
#----MAXIMILIAN-BALLARD-(MY-i3/CONFIG)--------------------------------|
#---------------------------------------------------------------------|
# i3 config file (v4)
#-------------------------------------------------Special-Binds-----------|
set $mod Mod1
set $Br       bindsym Mod1+
set $Br_CTRL  bindsym Mod1+Ctrl
set $SF       bindsym Mod1+Shift+
set $SF_CTRL  bindsym Mod1+Shift+Ctrl
set $Mb       bindsym --whole-window 
bindsym $mod+Shift+Escape     exec i3-input -F 'border pixel %s' -l 2 -P 'Width: ' 
bindsym $mod+Shift+o          exec "sleep 0.5; xset dpms force off"
# no confirm reload
bindsym $mod+Shift+c          reload
# restart
bindsym $mod+Shift+r          exec $HOME/bin/i3wm_config_check.sh --3
# hard restart
bindsym $mod+Shift+Ctrl+r     exec --no-startup-id    "xrdb -override ~/.Xresources ; $HOME/bin/i3wm_config_check.sh --3"
bindsym                $mod+Escape [tiling] border pixel 1
bindsym --release      $mod+Escape [tiling] border pixel 0
bindsym --whole-window $mod+button8    exec screengrab
bindsym --whole-window button8         exec $SCRIPT_screenshot --shot
bindsym --whole-window button9         exec $SCRIPT_key_mouse -m "-0.5" "-0.3"
# $Mb button8         $_  exec screengrab --no-win
# this sets default border flash, will be overwritten 
# set $B1         exec " i3-msg 'border pixel 1' " ;
# set $B2         exec " sleep 0.01; i3-msg '[tiling] border pixel 0' "
#-------------------------------------------------Scripts-----------------|
  set $SCRIPT_bluetooth        $HOME/bin/ubluetoggle.sh
  set $SCRIPT_border           $HOME/bin/i3wm_change_border.sh
  set $SCRIPT_clipboard        $HOME/bin/add_to_clip.sh
  set $SCRIPT_dmenu            $HOME/bin/my_dmenu.sh
  set $SCRIPT_joplin_start     $HOME/.local/bin/Joplin_start.sh
  set $SCRIPT_key_mouse        $HOME/bin/SetKeys.sh
  set $SCRIPT_kitty_session    $HOME/bin/kitty_session_dmenu.sh
  set $SCRIPT_monitor          $HOME/bin/auto_monitor.sh
  set $SCRIPT_polybar          $HOME/bin/polybar_manipulate.sh
  set $SCRIPT_screenshot       $HOME/bin/clipboard_copy_image.sh
  set $SCRIPT_send_key         $HOME/bin/i3wm_send_keys_to_window.sh
  set $SCRIPT_wallpaper        $HOME/bin/feh_wallpaper.sh
  set $SCRIPT_zathura          $HOME/bin/zathura_dbus_controller.sh
  set $balance_workspace       $HOME/.local/bin/i3_balance_workspace
  set $dmenu_search            $HOME/bin/dmenu_websearch.sh
  set $latex_screenshot        $HOME/bin/ocr_latex.sh
  # set $active_title_format    "<span size='smaller' background='#005500' foreground='#000000'> %class </span> <span foreground='#00FF00' size='smaller'> %title </span>"
  # set $nsxiv_title_format     "<span size='smaller' background='#005500'> %class </span>"
  # set $SCRIPT_xmsg            $HOME/bin/xmsg_quick.sh
  #sticky toggle
  # set $POPUP_DEFAULT      floating enable, 
#-------------------------------------------------Set---------------------|
  set $EXCLUDE_FLOAT_POPUP      qutebrowser|kitty_term|kitty_note|emacs|Tor Browser|octave
  set $calculator               octave
  set $mark_quickswitch         "QS"
  set $note                     kitty_note
  set $title_format_default     "<span size='smaller' background='#000000' > %class </span> <span foreground='#AAAAAA' background='#000000FF' size='smaller'> %title </span>" 
  set $title_format_only_title  "<span foreground='#AAAAAA' background='#000000FF' size='smaller'> %title </span>" 
  set $SCRATCHPAD_DEFAULT       floating enable, move scratchpad, scratchpad show, move position center
  set $FLOATING_DEFAULT         floating enable, move position center
  # set $SCRATCHPAD_TOP           scratchpad show, resize set 100ppt 59ppt, move position 100ppt 0ppt
  # set $SCRATCHPAD_BOTTOM        scratchpad show, resize set 100ppt 59ppt, move position 100ppt 40ppt
  #|qutebrowser
  #-----------Size------------------|
    set $QUTEBROWSER_SIZE 80ppt 80ppt
    # Default
      set $DefaultSize    70ppt 80ppt
    # Small
      set $SmallSize      40ppt 50ppt
  #---------------------------------|
  set $EXC    exec 	      --no-startup-id
  set $EXC_A  exec_always --no-startup-id
  set $FOCUSE_TEXT  #999999
  set $INACTI_TEXT  #0099FF
  set $UNFOCU_TEXT  #999999
  # ----set by border---| {{{
  set $B1 ;
  set $B2 ;
  set $_  ;
  set $-  #000000
  # --------------------| }}}
#-------------------------------------------------Resources---------------|
    set_from_resource $BRAVE_SCALE i3wm.BRAVE_SCALE 0.9
    set_from_resource $BROWSER     i3wm.browser brave
  #-----Border-File------------------------------------|
    set_from_resource $BORDER_FILE i3wm.BORDER_FILE borders/border_flash.conf
  #-----Left-Monitor-----------------------------------|
    set_from_resource $MON_P       i3wm.primary_monitor DVI-D-1
  #---Center-Monitor-----------------------------------|
    set_from_resource $MON_1       i3wm.other_monitor_1 DVI-D-1
  #----Right-Monitor-----------------------------------|
    set_from_resource $MON_2       i3wm.other_monitor_2 DVI-D-1
  #----Gaps--------------------------------------------|
    set_from_resource $IN_GAPS     i3wm.IN_GAPS  0
    set_from_resource $OUT_GAPS    i3wm.OUT_GAPS 0
    set_from_resource $TOP_GAPS    i3wm.TOP_GAPS 0
    set_from_resource $BOT_GAPS    i3wm.BOT_GAPS 0
    set_from_resource $R_GAPS      i3wm.R_GAPS   0
    set_from_resource $L_GAPS      i3wm.L_GAPS   0
#-------------------------------------------------------INCLUDE-----------|
  # border method
  include $BORDER_FILE
  include regular_bindings.conf
  include modes.conf
  include windows.conf
#-------------------------------------------------------SETTINGS----------|
  smart_gaps                    off            
  font                          pango:Hermit 11
  focus_on_window_activation    focus
  focus_follows_mouse           yes            
  floating_modifier             $mod+Ctrl      
  mouse_warping                 output
  floating_maximum_size         2000 x 2000
  workspace_auto_back_and_forth no             
  show_marks                    yes            
  title_align left
#---------------------------------------------------------EXECS-----------|
  # compositor
  $EXC    picom --daemon
  # hide mouse
  $EXC    unclutter --timeout 2 --fork
  # wallpaper
  $EXC    $SCRIPT_wallpaper "launch"
  # desktop bar
  $EXC_A  $SCRIPT_polybar "launch"
  $EXC    conky
